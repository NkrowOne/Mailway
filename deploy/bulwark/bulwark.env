# Valores fijos de Mailway para Bulwark 1.13 (ghcr.io/bulwarkmail/webmail).
# Se cargan con env_file en Compose o --env-file en docker run. Lo que
# depende de cada instalación lo pone el compose: JMAP_SERVER_URL,
# SESSION_SECRET, ADMIN_PASSWORD, APP_NAME, LOGIN_WEBSITE_URL y, si el
# certificado del motor no es público, NODE_EXTRA_CA_CERTS.
#
# Formato: NOMBRE=valor, sin comillas ni comentarios al final de la línea:
# Docker toma el valor literal. El porqué de cada valor, en README.md.

# Cuenta del buzón: contraseña, contraseñas de aplicación y verificación en
# dos pasos se gestionan en «Mi buzón», no en el correo web. Oculta la
# pestaña Seguridad y cierra el paso a los métodos x: de Stalwart.
STALWART_FEATURES=false
STALWART_JMAP_PASSTHROUGH_ENABLED=false
LOGIN_SHOW_TOTP=false
LOGIN_SHOW_TOKEN_LOGIN=false

# Administración de Bulwark: solo con ADMIN_PASSWORD, que conoce el panel.
# Un administrador del motor no entra por serlo.
STALWART_ADMIN_ACCESS=off
ADMIN_SESSION_TTL=3600

# Un único servidor JMAP, el de la instalación, y sin OAuth.
ALLOW_CUSTOM_JMAP_ENDPOINT=false
OAUTH_ENABLED=false

# Nada hacia terceros ni datos de la instancia a la vista.
BULWARK_TELEMETRY=off
BULWARK_UPDATE_CHECK=off
CONNECTOR_ENABLED=false
SEARCH_ENGINE_INDEXING=false
LOGIN_SHOW_VERSION=false

# Detrás de la pasarela: una sola IP en X-Forwarded-For y siempre HTTPS.
TRUSTED_PROXY_DEPTH=1
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Ajustes del usuario sincronizados entre dispositivos, cifrados con
# SESSION_SECRET en el volumen /app/data/settings.
SETTINGS_SYNC_ENABLED=true

LOG_FORMAT=json
LOG_LEVEL=info

# El contenedor va con la raíz en solo lectura: el estado de la comprobación
# de versiones y de la telemetría (las dos apagadas) va a /tmp, que es tmpfs.
# Sin esto, /api/system/update-status responde 500 al no poder crear su carpeta.
VERSION_CHECK_DATA_DIR=/tmp/version-check
TELEMETRY_DATA_DIR=/tmp/telemetry

# Marca de la instancia: deploy/bulwark/marca/mailway montada en
# /app/public/branding/mailway (solo lectura). Sin esto se verían el
# logotipo y el favicon de Bulwark. La de cada cliente va por dominio
# (domainBranding) y la aplica el panel.
APP_SHORT_NAME=Correo
FAVICON_URL=/branding/mailway/favicon.svg
PWA_ICON_URL=/branding/mailway/logo.svg
APP_LOGO_LIGHT_URL=/branding/mailway/logo.svg
APP_LOGO_DARK_URL=/branding/mailway/logo.svg
LOGIN_LOGO_LIGHT_URL=/branding/mailway/logo.svg
LOGIN_LOGO_DARK_URL=/branding/mailway/logo.svg
