# ============================================================================
# Configuración de despliegue de Mailway (deploy/.env)
# ----------------------------------------------------------------------------
# Lo más sencillo es no rellenar esto a mano: deploy/instalar.sh lo genera
# (con secretos aleatorios y permisos 600) y lo reutiliza al volver a
# ejecutarse. Para hacerlo a mano:
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# y rellena las variables marcadas como OBLIGATORIAS.
#
# Escribe los valores con texto libre entre comillas simples ('…'): así
# Compose no interpreta «$», «#» ni los espacios. Un valor así no puede
# contener a su vez una comilla simple.
#
# Lo usan docker-compose.mail.yml (junto a Skyway) y
# docker-compose.standalone.yml (sin Skyway).
# ============================================================================

# ---- Modo de instalación ---------------------------------------------------
# skyway (junto a Skyway) o autonoma (docker-compose.standalone.yml). Lo usa
# «deploy/instalar.sh --actualizar» para repetir la instalación en el mismo modo.
MAILWAY_INSTALACION=skyway

# ---- Motor de correo --------------------------------------------------------
# stalwart-0.16 (instalaciones nuevas) o stalwart-0.15 (las anteriores). Elige
# el fichero motor/<motor>/compose.yml que completan los compose. Sin valor
# se usa stalwart-0.15, el de las instalaciones que ya existían: así un
# deploy/.env antiguo nunca cambia de motor. No lo cambies a mano en un
# servidor con correo: para pasar de la 0.15 a la 0.16 usa
# «sudo mailway migrar-motor», que copia y convierte los datos, y vuelve
# atrás sola si algo falla (docs/DESPLIEGUE-SKYWAY.md, sección 8.3).
MAILWAY_MOTOR=stalwart-0.16

# ---- Nombres públicos (OBLIGATORIOS) --------------------------------------
# Cuelgan directamente del dominio base (mail., webmail. y panel.<dominio>):
# el panel deduce de ellos el dominio de la autoconfiguración.
#
# Servidor de correo: su registro A apunta a la IP del servidor y el PTR
# (DNS inverso) de esa IP debe devolver este mismo nombre.
MAIL_HOSTNAME=mail.miempresa.com
# Webmail (Roundcube), con HTTPS por Traefik.
WEBMAIL_HOSTNAME=webmail.miempresa.com
# Panel de Mailway. En el compose autónomo es obligatorio; con Skyway es
# informativo (el dominio del panel se define en su servicio de Skyway).
PANEL_HOSTNAME=panel.miempresa.com

# IPv4 pública del servidor (SPF, PTR y comprobaciones de entregabilidad).
MAILWAY_PUBLIC_IP=

# Nombre del servicio que ve el usuario en el webmail (marca blanca).
MAILWAY_BRAND='Webmail'

# Correo de contacto de Let's Encrypt: el del Traefik del compose autónomo y
# el del certificado que el motor pide por DNS-01 (con Cloudflare). Let's
# Encrypt rechaza los de example.com.
LETSENCRYPT_EMAIL=

# Junto a Skyway: correo de la cuenta de administración del panel que crea el
# emparejado con Skyway si el panel aún no tiene ninguna (por defecto, el de
# Let's Encrypt). La contraseña no se guarda aquí: el instalador la muestra
# una sola vez. Lo usa también «deploy/instalar.sh --emparejar».
MAILWAY_ADMIN_EMAIL=

# ---- Credencial del motor (OBLIGATORIA) -------------------------------------
# Contraseña del administrador del motor (usuario «admin»). Genera una larga:
# openssl rand -hex 24
#   - Stalwart 0.16: el motor la toma de aquí en cada arranque
#     (STALWART_RECOVERY_ADMIN). Si la cambias, cámbiala también en las
#     variables del panel y recrea el motor.
#   - Stalwart 0.15: el motor solo la toma en su PRIMER arranque; cambiarla
#     aquí después no cambia la del motor. Aun así debe ser siempre la
#     VIGENTE: el instalador y el extractor del certificado la usan.
STALWART_ADMIN_PASSWORD=

# ---- Webmail --------------------------------------------------------------
# Clave de cifrado de sesiones de Roundcube (24 caracteres, OBLIGATORIA).
# Fija para que las sesiones sobrevivan a la recreación del contenedor:
#   openssl rand -hex 12
ROUNDCUBE_DES_KEY=
# URL pública del panel: el webmail enlaza a «Mi buzón» (/mi-buzon).
MAILWAY_PANEL_URL=https://panel.miempresa.com
# URL pública del webmail (el panel la muestra a los clientes).
MAILWAY_WEBMAIL_URL=https://webmail.miempresa.com
# Dirección INTERNA del panel para el cambio de contraseña desde el webmail.
# Con Skyway: http://skyway-<proyecto>-<servicio>:4100 (el instalador la
# rellena con el nombre real; por defecto, proyecto «mailway» y servicio
# «panel»). En el compose autónomo: http://mailway-panel:4100.
MAILWAY_PANEL_INTERNAL_URL=http://skyway-mailway-panel:4100

# ---- Secretos compartidos con el panel ------------------------------------
# Deben valer lo mismo aquí y en las variables del servicio del panel (en
# Skyway, pestaña Variables). Genéralos con: openssl rand -hex 24
#
# Clave maestra del panel (firma sesiones y cifra secretos). Si falta, el
# panel genera una y la guarda en su volumen /data.
MAILWAY_SECRET=
# Token de puesta en marcha: el asistente lo exige para crear el primer
# administrador (evita que el primer visitante se quede con el panel).
MAILWAY_SETUP_TOKEN=
# Token con el que Traefik consulta las rutas de los dominios de clientes.
MAILWAY_TRAEFIK_TOKEN=
# Secreto entre el webmail y el panel para el cambio de contraseña. Vacío
# desactiva la pestaña «Contraseña» del webmail.
MAILWAY_WEBMAIL_TOKEN=

# ---- Red interna ----------------------------------------------------------
# Subred fija de mailway-internal: el motor exime SOLO este rango de su
# bloqueo automático (los fallos de contraseña del webmail llegan todos desde
# su IP). Cambia las dos a la vez, y también MAILWAY_ENGINE_TRUSTED_NETWORK
# en el panel, si choca con otra red del servidor (el instalador lo comprueba
# contra las redes de Docker y las rutas del servidor).
MAILWAY_INTERNAL_SUBNET=10.203.53.0/24
MAILWAY_MAIL_INTERNAL_IP=10.203.53.10

# ---- Certificado del SMTP interno (solo compose autónomo) -----------------
# La API de envío del panel verifica el certificado del motor contra
# MAIL_HOSTNAME. Solo mientras el motor no tenga un certificado válido
# (instalación sin proxy propio ni Cloudflare), 1 acepta el autofirmado.
# Retíralo en cuanto el certificado exista (Ajustes → Servidor de correo).
# MAILWAY_SMTP_ALLOW_SELF_SIGNED=1

# ---- Certificado de Traefik para IMAP/SMTP (perfil «tls») -----------------
# Con Stalwart 0.16 (y con la 0.15 sin el ACME del propio motor), el extractor
# (servicio certs-dumper) lee en solo lectura el acme.json de Traefik y lleva
# al motor ÚNICAMENTE el certificado de MAIL_HOSTNAME; lo renueva solo y
# vuelve al anterior si el motor no lo sirve (docs/DESPLIEGUE-SKYWAY.md,
# sección 5.2).
# Volumen del acme.json del Traefik de Skyway: <carpeta de Skyway>_traefik-letsencrypt.
# Compruébalo con: docker volume ls | grep letsencrypt
TRAEFIK_ACME_VOLUME=skyway_traefik-letsencrypt

# ---- Volúmenes de una instalación anterior a la 1.0 -----------------------
# Hasta la 1.0 el proyecto de Compose se llamaba «deploy» y los volúmenes
# deploy_*. El instalador los detecta y los fija aquí para no perder datos:
# MAILWAY_MAIL_VOLUME=deploy_mailway-mail-data
# MAILWAY_WEBMAIL_DB_VOLUME=deploy_mailway-webmail-db
# MAILWAY_PANEL_VOLUME=deploy_mailway-panel-data

# ---- Volúmenes de Stalwart 0.16 --------------------------------------------
# Por defecto mailway-stalwart-etc y mailway-stalwart-data. La migración desde
# la 0.15 crea unos nuevos con la fecha y los fija aquí, junto con la fecha de
# la migración (MAILWAY_MOTOR_MIGRADO): el volumen de la 0.15
# (MAILWAY_MAIL_VOLUME o mailway-mail-data) se conserva intacto como vuelta
# atrás hasta que se retira con «sudo mailway retirar-motor-anterior».
# MAILWAY_STALWART_ETC_VOLUME=mailway-stalwart-etc-20261009-031240
# MAILWAY_STALWART_DATA_VOLUME=mailway-stalwart-data-20261009-031240
# MAILWAY_MOTOR_MIGRADO=2026-10-09T03:12:40Z


# ============================================================================
# Variables del PANEL cuando lo despliega Skyway (NO se leen de este fichero)
# ----------------------------------------------------------------------------
# El instalador las crea en el servicio «panel» de Skyway. A mano, ponlas
# en la pestaña Variables del servicio (repositorio NkrowOne/Mailway, rama
# main, puerto 4100, volumen /data, comprobación /api/health):
#
#   STALWART_URL=http://mailway-mail:8080
#   STALWART_ADMIN_USER=admin
#   STALWART_ADMIN_PASSWORD=<la de arriba>
#   STALWART_SMTP_HOST=mailway-mail
#   STALWART_SMTP_PORT=587
#   MAILWAY_SECRET=<el de arriba>
#   MAILWAY_SETUP_TOKEN=<el de arriba>
#   MAILWAY_TRAEFIK_TOKEN=<el de arriba>
#   MAILWAY_WEBMAIL_TOKEN=<el de arriba>
#   MAILWAY_MAIL_HOSTNAME=mail.miempresa.com
#   MAILWAY_PUBLIC_IP=<IP del servidor>
#   MAILWAY_WEBMAIL_URL=https://webmail.miempresa.com
#   MAILWAY_PANEL_URL=https://panel.miempresa.com
#   MAILWAY_ENGINE_TRUSTED_NETWORK=10.203.53.0/24   # = MAILWAY_INTERNAL_SUBNET
#
# Contraseña de administración del panel (opcional, 10–200 caracteres):
# mientras exista, es siempre la de esa cuenta y no se cambia desde el panel.
# Sin MAILWAY_ADMIN_EMAIL se aplica al único administrador; con un correo que
# no existe, crea ese administrador (recuperar el acceso sin terminal).
# STALWART_ADMIN_PASSWORD es la del motor, no la del panel.
#   MAILWAY_ADMIN_EMAIL=admin@miempresa.com
#   MAILWAY_ADMIN_PASSWORD=<una contraseña larga>
#   MAILWAY_ADMIN_NAME=Administración   # opcional, solo al crear
#
# Con esas variables, el asistente del panel conecta el motor con un clic
# (la contraseña no pasa por el navegador) y aplica solo los ajustes
# recomendados del motor.
#
# El panel verifica el certificado del SMTP interno (mailway-mail:587) contra
# MAILWAY_MAIL_HOSTNAME. Solo si el motor aún no tiene certificado válido,
# MAILWAY_SMTP_ALLOW_SELF_SIGNED=1 acepta el autofirmado; retíralo después
# (el instalador lo retira al actualizar si el certificado ya está configurado).
#
# El nombre del contenedor del panel lo pone Skyway
# (skyway-<proyecto>-<servicio>) y el panel lo deduce de SKYWAY_PROJECT y
# SKYWAY_SERVICE. Solo si cambias los nombres por defecto:
#   MAILWAY_WEBMAIL_BACKEND_URL=http://mailway-webmail:80
#   MAILWAY_PANEL_BACKEND_URL=http://skyway-mailway-panel:4100
#   MAILWAY_TRAEFIK_CERTRESOLVER=le
#
# Cada dominio de correo con la propiedad comprobada recibe solo su webmail de
# marca (webmail.<dominio>, con su registro en Cloudflare con proxy). Se activa
# y desactiva en Ajustes (y por cliente en su ficha o desde Skyway); esta
# variable solo fija el valor inicial del interruptor general:
#   MAILWAY_WEBMAIL_AUTOMATICO=0
