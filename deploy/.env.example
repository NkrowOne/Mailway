# ===== Stack de correo de Mailway (docker-compose.mail.yml) =====

# FQDN del servidor de correo. Su registro A debe apuntar a la IP del
# servidor y el PTR (DNS inverso) de la IP debe devolver este nombre.
MAIL_HOSTNAME=mail.tuempresa.com

# Dominio del webmail (Roundcube), servido con TLS por el Traefik de Skyway.
WEBMAIL_HOSTNAME=webmail.tuempresa.com

# Contraseña del administrador del motor (usuario "admin"). Solo se aplica
# en el PRIMER arranque del contenedor. Genera una larga:
#   openssl rand -base64 24
STALWART_ADMIN_PASSWORD=

# Solo si usas el perfil `tls` (volcado de certificados de Traefik):
# nombre real del volumen del acme.json de Skyway.
# Compruébalo con: docker volume ls | grep letsencrypt
TRAEFIK_ACME_VOLUME=skyway_traefik-letsencrypt
