# ===== Stack de correo de Mailway (docker-compose.mail.yml) =====

# FQDN del servidor de correo. Su registro A debe apuntar a la IP del
# servidor y el PTR (DNS inverso) de la IP debe devolver este nombre.
MAIL_HOSTNAME=mail.tuempresa.com

# Dominio del webmail (Roundcube), servido con TLS por el Traefik de Skyway.
WEBMAIL_HOSTNAME=webmail.tuempresa.com

# Contraseña del administrador del motor (usuario "admin"). Solo se aplica
# en el PRIMER arranque del motor. El sincronizador TLS necesita siempre
# la contraseña vigente: si la rotas en Stalwart, actualiza también este
# fichero y Ajustes → Motor del panel. Genera una larga:
#   openssl rand -base64 24
STALWART_ADMIN_PASSWORD=

# Obligatorio: sincronización y renovación automáticas del TLS del motor.
# nombre real del volumen del acme.json de Skyway.
# Compruébalo con: docker volume ls | grep letsencrypt
TRAEFIK_ACME_VOLUME=skyway_traefik-letsencrypt


# ===== Variables del PANEL (se ponen en Skyway, no aquí) =====
# Se listan como referencia; el panel lo despliega Skyway y sus variables se
# configuran en la pestaña Variables de su servicio.
#
#   MAILWAY_MAIL_HOSTNAME=mail.tuempresa.com
# Tiene prioridad sobre el valor guardado y se sincroniza con Stalwart al
# redesplegar el panel. Mantén MAIL_HOSTNAME del stack alineado; los cambios
# de DNS/PTR/certificados externos se hacen aparte.
#   MAILWAY_PUBLIC_IP=<IP del servidor>
#   MAILWAY_WEBMAIL_URL=https://webmail.tuempresa.com
#   STALWART_URL=http://mailway-mail:8080
#   STALWART_ADMIN_USER=admin
#   STALWART_ADMIN_PASSWORD=<la misma de arriba>
#   STALWART_SMTP_HOST=mailway-mail
#
# Marca blanca (dominios propios de tus clientes). Solo si cambias los
# nombres por defecto de los contenedores:
#   MAILWAY_WEBMAIL_BACKEND_URL=http://mailway-webmail:80
#   MAILWAY_TRAEFIK_CERTRESOLVER=le
# Opcional: habilita que un cliente use TAMBIÉN su dominio para el panel.
# Debe ser el nombre del contenedor del panel (míralo con docker ps):
#   MAILWAY_PANEL_BACKEND_URL=http://mailway-panel:4100
