{
  "name": "@mailway/server",
  "version": "1.4.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "reset-password": "tsx src/tools/reset-password.ts",
    "emparejar": "tsx src/tools/emparejar.ts",
    "cloudflare": "tsx src/tools/cloudflare.ts",
    "motor": "tsx src/tools/motor.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx --import ./test/env.ts test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
